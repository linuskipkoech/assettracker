# Copy this file to .env and fill in real values before running the app.

# SQLite (default, zero-config). For production, point this at a Postgres
# database instead, e.g. postgresql://user:password@host:5432/assettracker
DATABASE_URL="file:./dev.db"

# Used to sign auth session cookies/tokens. Generate a strong random value,
# e.g. `openssl rand -base64 32`. Never reuse the dev value in production.
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Your own Anthropic API key (https://console.anthropic.com/). Required for
# the AI Assistant feature (planting advice, general asset guidance). The
# app runs fine without it — the assistant will just report itself offline.
ANTHROPIC_API_KEY=""

# --- Beneficiaries & inactivity safety net --------------------------------

# Resend API key (https://resend.com/) for sending check-in and beneficiary
# notification emails. Without it, the app logs what it would have sent
# instead of actually sending — everything still works for local testing,
# you just won't receive real email.
RESEND_API_KEY=""
EMAIL_FROM="AssetTracker KE <onboarding@resend.dev>"

# Base URL used to build the confirmation links inside those emails.
# Defaults to NEXTAUTH_URL if unset. Set this explicitly once you have a
# real production domain.
APP_URL="http://localhost:3000"

# Shared secret for POST /api/cron/check-inactivity, which runs the
# inactivity-check engine. Generate one with `openssl rand -base64 32`.
# The endpoint refuses to run at all until this is set. See README.md for
# how to schedule it.
CRON_SECRET=""
